#!/usr/bin/python3
"""Capture a PNG of a Home Assistant frontend page with headless Chromium.

Chromium starts for one capture and exits afterwards. It is driven over the
DevTools pipe, so no network port is opened. The frontend authenticates with a
long-lived access token injected into its local storage.
"""

import argparse
import base64
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time

HA_URL = "http://homeassistant:8123"
TOKEN_FILE = "/run/amp-runner/screenshot-token"
CHROMIUM = "/usr/lib/chromium/chromium-headless-shell"
MAX_HEIGHT = 8000

# True once the frontend has resolved the panel and the panel finished loading.
READY_JS = """(() => {
  const main = document.querySelector("home-assistant")
    ?.shadowRoot?.querySelector("home-assistant-main");
  const resolver = main?.shadowRoot?.querySelector("partial-panel-resolver");
  if (!resolver || resolver._loading) return false;
  const panel = resolver.children[0];
  return !!panel && !panel._loading;
})()"""

# Height of the tallest scrollable element, including inside shadow roots.
MEASURE_JS = """(() => {
  let max = document.documentElement.scrollHeight;
  const walk = (root) => {
    for (const el of root.querySelectorAll("*")) {
      max = Math.max(max, el.scrollHeight);
      if (el.shadowRoot) walk(el.shadowRoot);
    }
  };
  walk(document);
  return max;
})()"""


class DevTools:
    def __init__(self, args):
        self.reader_fd, chrome_writes = os.pipe()
        chrome_reads, self.writer_fd = os.pipe()
        # Chromium reads commands from fd 3 and writes responses to fd 4.
        self.process = subprocess.Popen(
            args,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            pass_fds=(3, 4),
            preexec_fn=lambda: (os.dup2(chrome_reads, 3), os.dup2(chrome_writes, 4)),
            start_new_session=True,
        )
        os.close(chrome_reads)
        os.close(chrome_writes)
        self.buffer = b""
        self.next_id = 0
        self.session = None
        self.errors = []

    def _read_message(self):
        while b"\0" not in self.buffer:
            chunk = os.read(self.reader_fd, 1 << 20)
            if not chunk:
                raise RuntimeError("Chromium exited unexpectedly")
            self.buffer += chunk
        message, self.buffer = self.buffer.split(b"\0", 1)
        return json.loads(message)

    def call(self, method, params=None, session=True):
        self.next_id += 1
        request = {"id": self.next_id, "method": method, "params": params or {}}
        if session and self.session:
            request["sessionId"] = self.session
        os.write(self.writer_fd, json.dumps(request).encode() + b"\0")
        while True:
            message = self._read_message()
            if message.get("id") == self.next_id:
                if "error" in message:
                    raise RuntimeError(f"{method}: {message['error'].get('message')}")
                return message.get("result", {})
            self._record_event(message)

    def _record_event(self, message):
        method = message.get("method")
        params = message.get("params", {})
        if method == "Runtime.exceptionThrown":
            details = params.get("exceptionDetails", {})
            text = details.get("exception", {}).get("description") or details.get("text")
            self.errors.append(f"exception: {text}")
        elif method == "Runtime.consoleAPICalled" and params.get("type") == "error":
            text = " ".join(str(arg.get("value", arg.get("description", ""))) for arg in params.get("args", []))
            self.errors.append(f"console: {text}")

    def evaluate(self, expression):
        result = self.call("Runtime.evaluate", {"expression": expression, "returnByValue": True})
        return result.get("result", {}).get("value")

    def close(self):
        try:
            self.call("Browser.close", session=False)
            self.process.wait(timeout=5)
        except (OSError, RuntimeError, subprocess.TimeoutExpired):
            pass
        # Chromium's renderer and utility processes share its process group.
        try:
            os.killpg(self.process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        self.process.wait()
        os.close(self.reader_fd)
        os.close(self.writer_fd)


def parse_args():
    parser = argparse.ArgumentParser(description="Capture a PNG of a Home Assistant frontend page.")
    parser.add_argument("path", help="frontend path, such as /lovelace/0 or /config/integrations")
    parser.add_argument("output", help="PNG file to write")
    parser.add_argument("--width", type=int, default=1280, help="viewport width in pixels (default 1280)")
    parser.add_argument("--height", default="auto", help="viewport height in pixels, or auto for the full page (default auto)")
    parser.add_argument("--wait", type=int, default=2000, help="milliseconds to wait after the page loads (default 2000)")
    parser.add_argument("--timeout", type=int, default=30, help="seconds to wait for the page to load (default 30)")
    parser.add_argument("--dark", action="store_true", help="render with the dark theme")
    return parser.parse_args()


def read_token():
    try:
        with open(TOKEN_FILE, encoding="utf-8") as token_file:
            token = token_file.read().strip()
    except FileNotFoundError:
        token = ""
    if not token:
        sys.exit("ha-screenshot: set the screenshot_token app option to a Home Assistant long-lived access token")
    return token


def capture(args, token):
    if not args.path.startswith("/"):
        sys.exit("ha-screenshot: path must start with /")
    full_page = args.height == "auto"
    height = 900 if full_page else int(args.height)

    profile = tempfile.mkdtemp(prefix="ha-screenshot-")
    browser = DevTools([
        CHROMIUM,
        "--remote-debugging-pipe",
        f"--user-data-dir={profile}",
        "--no-sandbox",
        "--disable-gpu",
        "--disable-dev-shm-usage",
        "--disable-extensions",
        "--disable-background-networking",
        "--disable-component-update",
        "--disable-sync",
        "--hide-scrollbars",
        "--mute-audio",
        "--no-first-run",
        "about:blank",
    ])
    try:
        targets = browser.call("Target.getTargets")["targetInfos"]
        page = next(target for target in targets if target["type"] == "page")
        browser.session = browser.call(
            "Target.attachToTarget", {"targetId": page["targetId"], "flatten": True}, session=False
        )["sessionId"]

        local_storage = {
            "hassTokens": json.dumps({
                "access_token": token,
                "token_type": "Bearer",
                "expires_in": 1800,
                "hassUrl": HA_URL,
                "clientId": f"{HA_URL}/",
                "expires": 9999999999999,
                "refresh_token": "",
            }),
            "dockedSidebar": json.dumps("always_hidden"),
            "selectedTheme": json.dumps({"dark": args.dark}),
        }
        browser.call("Runtime.enable")
        browser.call("Page.enable")
        browser.call("Page.addScriptToEvaluateOnNewDocument", {
            "source": f"for (const [k, v] of Object.entries({json.dumps(local_storage)})) localStorage.setItem(k, v);"
        })
        browser.call("Emulation.setDeviceMetricsOverride", {
            "width": args.width, "height": height, "deviceScaleFactor": 1, "mobile": False
        })
        browser.call("Emulation.setEmulatedMedia", {
            "features": [{"name": "prefers-reduced-motion", "value": "reduce"}]
        })
        browser.call("Page.navigate", {"url": HA_URL + args.path})

        deadline = time.monotonic() + args.timeout
        while not browser.evaluate(READY_JS):
            if browser.evaluate("location.pathname").startswith("/auth/"):
                sys.exit("ha-screenshot: Home Assistant rejected the screenshot token and showed the login page")
            if time.monotonic() > deadline:
                print("ha-screenshot: page did not report loaded before the timeout; capturing anyway", file=sys.stderr)
                break
            time.sleep(0.2)
        time.sleep(args.wait / 1000)

        if full_page:
            # Dashboards scroll inside the frontend's own layout, and cards below
            # the fold only lay out once they are visible, so grow the viewport to
            # the tallest scrollable element until the measurement stops growing.
            for _ in range(10):
                measured = min(browser.evaluate(MEASURE_JS), MAX_HEIGHT)
                if measured <= height:
                    break
                height = measured
                browser.call("Emulation.setDeviceMetricsOverride", {
                    "width": args.width, "height": height, "deviceScaleFactor": 1, "mobile": False
                })
                time.sleep(1)
            # Cards revealed by the resize load their data now; give them the
            # same settling time as the first screen.
            time.sleep(args.wait / 1000)

        image = browser.call("Page.captureScreenshot", {"format": "png"})["data"]
        with open(args.output, "wb") as output:
            output.write(base64.b64decode(image))
        print(f"{args.output}: {args.width}x{height} {HA_URL}{args.path}")
        for error in browser.errors[:20]:
            print(f"page {error}"[:300], file=sys.stderr)
    finally:
        browser.close()
        shutil.rmtree(profile, ignore_errors=True)


if __name__ == "__main__":
    arguments = parse_args()
    capture(arguments, read_token())
